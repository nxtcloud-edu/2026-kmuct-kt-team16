# Snaptok 서버 환경변수 예시.
# 실제 값은 server/.env 에 넣는다. server/.env 는 .gitignore 로 커밋되지 않는다.
# API 키를 이 예시 파일이나 코드/커밋에 넣지 말 것.

# --- LLM (분석) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# 키가 비어 있으면 서버는 mock 분석 모드로 동작한다(테스트용).
LLM_API_KEY=

# --- 장소 좌표화 (선택) ---
# 카카오 REST 키가 없으면 server/data/places_seed.json 으로 대체한다.
KAKAO_REST_API_KEY=

# --- 구글 캘린더 동기화 (선택, P1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# off | google  (기본 off)
CALENDAR_SYNC=off

# --- 라우팅 임계값 ---
CONFIDENCE_ACTION=0.7
CONFIDENCE_MEMORY=0.55

# --- 시간대 / 시연 날짜 ---
DEFAULT_TIMEZONE=Asia/Seoul
# 시연용 오늘 날짜 고정(예: 2026-09-20). 비우면 실제 오늘 날짜 사용.
DEMO_TODAY=2026-09-20
